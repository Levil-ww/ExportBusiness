{
  "manifest_version": 3,
  "name": "生意参谋商品与内容自动下载",
  "version": "0.8.23",
  "description": "进入商品或内容模块后，尝试点击页面自带的下载按钮。",
  "permissions": [
    "nativeMessaging",
    "storage",
    "downloads",
    "alarms",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "生意参谋下载设置",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sycm.taobao.com/*",
        "https://web.taobao.com/s-guanghe-creator/asset-overview*"
      ],
      "all_frames": true,
      "js": [
        "calendar.js",
        "product.js",
        "traffic.js",
        "search.js",
        "driver.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
